@model DataTable
@{var a=Model.Rows[0];}
<a href="/Judge">← Bàn chấm thi</a><h1>@a["Title"]</h1><img class="photo" src="/Assets/Photo/@a["SubmissionId"]" alt="Tác phẩm dự thi"/><p>@a["Stock"] · ISO @a["ISO"] · @a["Format"] · @a["Camera"] / @a["Lens"]<br/>Khung @a["FrameNumber"] · @a["Location"]<br/>Scan: @a["ScanSpecs"]</p><p>Chấm theo thang 0–10. Sau khi xác nhận sẽ không sửa được điểm.</p>
@foreach(DataRow r in ((DataTable)ViewBag.Criteria).Rows){<form class="panel" asp-action="Score" method="post"><input name="assignment" type="hidden" value="@a["AssignmentId"]"/><input name="criterion" type="hidden" value="@r["CriterionId"]"/><h3>@r["Name"] · trọng số @r["Weight"]</h3><label>Điểm</label><input name="score" type="number" step="0.01" min="0" max="10" value="@r["Score"]" required/><label>Nhận xét</label><textarea name="comment" maxlength="1000">@r["Comment"]</textarea>@if(!(bool)a["Finalized"]&&a["State"].ToString()=="Open"){<button>Lưu tiêu chí</button>}</form>}
@if(!(bool)a["Finalized"]&&a["State"].ToString()=="Open"){<form asp-action="FinalizeScore" method="post"><input name="id" type="hidden" value="@a["AssignmentId"]"/><button>Xác nhận hoàn tất chấm bài</button></form>}
