@model DataTable
<h1>Quản trị nền tảng.</h1><p>Người dùng đăng ký trước, sau đó quản trị viên cấp vai trò. Đổi quyền hoặc khóa tài khoản sẽ thu hồi phiên đăng nhập.</p><div class="table-wrap"><table><thead><tr><th>Người dùng</th><th>Vai trò và trạng thái</th></tr></thead><tbody>@foreach(DataRow r in Model.Rows){<tr><td><strong>@r["Name"]</strong><br/>@r["Email"]<br/>Hiện tại: @r["Role"] · Active: @r["Active"]</td><td><form class="row" asp-action="UserRole" method="post"><input name="id" type="hidden" value="@r["UserId"]"/><select name="role">@foreach(var role in new[]{"Participant","Organizer","Judge","Admin"}){<option value="@role" selected="@(r["Role"].ToString()==role)">@role</option>}</select><label><input name="active" type="checkbox" value="true" checked="@((bool)r["Active"])"/> Hoạt động</label><button>Lưu</button></form></td></tr>}</tbody></table></div>
<h2>Nhật ký hoạt động gần đây</h2><div class="table-wrap"><table><thead><tr><th>UTC</th><th>Người dùng</th><th>Hành động</th><th>Đối tượng</th><th>Chi tiết</th></tr></thead><tbody>@foreach(DataRow r in ((DataTable)ViewBag.Logs).Rows){<tr><td>@r["OccurredAt"]</td><td>@r["ActorId"]</td><td>@r["Action"]</td><td>@r["EntityId"]</td><td>@r["Detail"]</td></tr>}</tbody></table></div>

<h2>Danh mục phim</h2><div class="grid">@foreach(DataRow r in ((DataTable)ViewBag.Stocks).Rows){<div class="card">@r["Brand"] @r["Name"] · ISO @r["DefaultISO"]</div>}</div><form class="row panel" asp-action="Stock" method="post"><div><label>Hãng</label><input name="brand" maxlength="80" required/></div><div><label>Dòng phim</label><input name="name" maxlength="100" required/></div><div><label>ISO mặc định</label><input name="iso" type="number" min="1" max="102400" required/></div><button>Thêm danh mục phim</button></form>

<h2>Cấu hình hệ thống</h2><p>RequireNegative: 1 = bắt buộc mã tham chiếu âm bản cho bài mới; 0 = không bắt buộc. Banner: thông báo trang chủ. Kết nối SQL, JWT, cloud và API key cấu hình riêng qua secrets.</p>@foreach(DataRow setting in ((DataTable)ViewBag.Settings).Rows){<form class="row panel" asp-action="Setting" method="post"><input type="hidden" name="key" value="@setting["SettingKey"]"/><div><label>@setting["SettingKey"]</label><input name="value" value="@setting["SettingValue"]" maxlength="1000"/></div><button>Lưu cấu hình</button></form>}
