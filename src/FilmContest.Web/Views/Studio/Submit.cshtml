@model SubmissionForm
<h1>Gửi một góc nhìn.</h1><p>JPEG/PNG tối đa 10 MB; ít nhất 800×600, tối đa 40 megapixel. Bài chỉ được nhận trong thời gian cuộc thi mở.</p>
<form class="form panel" asp-action="Submit" method="post" enctype="multipart/form-data"><div asp-validation-summary="All"></div><input type="hidden" asp-for="ContestId"/>
<label asp-for="Title">Tên tác phẩm</label><input asp-for="Title"/><label asp-for="CategoryId">Hạng mục</label><select asp-for="CategoryId">@foreach(DataRow r in ((DataTable)ViewBag.Categories).Rows){<option value="@r["CategoryId"]">@r["Name"]</option>}</select>
<label asp-for="RollId">Cuộn phim</label><select asp-for="RollId">@foreach(DataRow r in ((DataTable)ViewBag.Rolls).Rows){<option value="@r["RollId"]">@r["Name"] · @r["Stock"]</option>}</select><small>Chưa có cuộn phim? <a href="/Studio/Rolls">Thêm cuộn phim trước</a>.</small>
<label asp-for="FrameNumber">Số khung hình</label><input asp-for="FrameNumber"/><label asp-for="Location">Địa điểm chụp</label><input asp-for="Location" maxlength="300"/><label asp-for="ScanSpecs">Thông số scan (máy scan, độ phân giải…)</label><textarea asp-for="ScanSpecs"></textarea><label asp-for="NegativeReference">Mã tham chiếu âm bản / contact sheet (không bắt buộc)</label><input asp-for="NegativeReference" maxlength="500"/><label asp-for="Photo">Ảnh dự thi</label><input asp-for="Photo" type="file" accept="image/jpeg,image/png"/><p>Khi nộp, bạn xác nhận có quyền sử dụng tác phẩm và đồng ý thể lệ cuộc thi.</p><button>Nộp bài dự thi</button></form>
