@model DataTable
<h1>Nhật ký cuộn phim.</h1><div class="grid"><section class="panel"><h2>Thêm cuộn phim</h2><form method="post" asp-action="AddRoll"><label>Tên cuộn phim</label><input name="Name" required maxlength="100"/><label>Dòng phim (ví dụ Kodak Gold 200)</label><select name="StockId">@foreach(DataRow stock in ((DataTable)ViewBag.Stocks).Rows){<option value="@stock["StockId"]">@stock["Brand"] @stock["Name"] · ISO @stock["DefaultISO"]</option>}</select><label>ISO</label><input name="ISO" type="number" value="200" min="1" max="102400"/><label>Máy ảnh</label><input name="Camera" required maxlength="100"/><label>Ống kính</label><input name="Lens" required maxlength="100"/><label>Khổ phim</label><select name="Format"><option>35mm</option><option>120</option><option>Large format</option></select><label>Phòng tráng phim</label><input name="Lab" maxlength="180"/><button>Lưu cuộn phim</button></form></section><section>@foreach(DataRow r in Model.Rows){<article class="card"><h3>@r["Name"]</h3><p>@r["Stock"] · ISO @r["ISO"] · @r["Format"]</p><p>@r["Camera"] / @r["Lens"]</p><p>Lab: @r["Lab"]</p></article>}</section></div>
