@model DataTable
@{ViewData["Title"]="Bài dự thi của tôi";}
<p class="eyebrow">Your photographic journey</p><h1>Bài dự thi của tôi.</h1><div class="actions"><a class="button" href="/Contests">Tìm cuộc thi để nộp ảnh</a><a class="button secondary" href="/Studio/Rolls">Quản lý cuộn phim</a></div>
<div class="grid">@foreach(DataRow r in Model.Rows){<article class="card"><img class="thumb" src="/Assets/Photo/@r["SubmissionId"]" alt="@r["Title"]"/><span class="badge">@r["Status"]</span><h3>@r["Title"]</h3><p>@r["ContestTitle"]</p><a href="/Studio/Feedback/@r["SubmissionId"]">Xem phản hồi →</a></article>}</div>
