@model ContestForm
<h1>Tạo cuộc thi mới.</h1><form class="form panel" asp-action="Create" method="post"><div asp-validation-summary="All"></div><label asp-for="Title">Tên cuộc thi</label><input asp-for="Title"/><label asp-for="Rules">Thể lệ, yêu cầu ảnh và cơ cấu giải thưởng</label><textarea asp-for="Rules"></textarea><label asp-for="Opens">Bắt đầu nhận bài (UTC)</label><input asp-for="Opens" type="datetime-local"/><label asp-for="Closes">Kết thúc nhận bài (UTC)</label><input asp-for="Closes" type="datetime-local"/><label asp-for="MaxEntries">Số bài tối đa / người</label><input asp-for="MaxEntries"/><label asp-for="Category">Hạng mục đầu tiên</label><input asp-for="Category" maxlength="120" required/><button>Tạo bản nháp</button></form>
