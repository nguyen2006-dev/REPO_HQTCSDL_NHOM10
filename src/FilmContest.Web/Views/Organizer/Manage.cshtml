@model DataTable
@{var c=Model.Rows[0];var id=(int)c["ContestId"];var status=c["Status"].ToString();ViewData["Title"]=c["Title"];}
<span class="badge">@status</span><h1>@c["Title"]</h1><p>@c["Opens"] — @c["Closes"] UTC</p><div class="actions"><a class="button secondary" href="/Organizer/Report/@id">Báo cáo</a><a class="button secondary" href="/Organizer/Export/@id">Tải bảng điểm CSV</a><form asp-action="Clone" method="post"><input name="id" value="@id" type="hidden"/><button>Sao chép làm mẫu mới</button></form></div>
@if(status=="Draft"){
<section class="grid"><div class="panel"><h2>Hạng mục</h2>@foreach(DataRow r in ((DataTable)ViewBag.Categories).Rows){<p>@r["Name"]</p>}<form asp-action="Configure" method="post"><input type="hidden" name="id" value="@id"/><input type="hidden" name="operation" value="category"/><label>Tên hạng mục</label><input name="name" maxlength="120" required/><button>Thêm hạng mục</button></form></div>
<div class="panel"><h2>Tiêu chí</h2>@foreach(DataRow r in ((DataTable)ViewBag.Criteria).Rows){<p>@r["Name"] · @r["Weight"]</p>}<form asp-action="Configure" method="post"><input type="hidden" name="id" value="@id"/><input type="hidden" name="operation" value="clearcriteria"/><button>Xóa bộ tiêu chí để nhập lại</button></form><form asp-action="Configure" method="post"><input type="hidden" name="id" value="@id"/><input type="hidden" name="operation" value="criterion"/><label>Tên tiêu chí</label><input name="name" maxlength="100" required/><label>Trọng số (0–1; tổng tất cả = 1)</label><input name="weight" type="number" min="0.0001" max="1" step="0.0001" required/><button>Thêm tiêu chí</button></form></div>
<div class="panel"><h2>Giải thưởng</h2>@foreach(DataRow r in ((DataTable)ViewBag.Awards).Rows){<p>@r["Name"]</p>}<form asp-action="Configure" method="post"><input type="hidden" name="id" value="@id"/><input type="hidden" name="operation" value="award"/><label>Tên giải (giá trị giải ghi trong thể lệ)</label><input name="name" maxlength="120" required/><button>Thêm giải</button></form></div></section>
<form asp-action="Open" method="post"><input name="id" type="hidden" value="@id"/><button>Mở cuộc thi nhận đăng ký và bài dự thi</button></form>
}
@if(status=="Draft"||status=="Judging"){
<details><summary>Lịch chấm thi (UTC)</summary><p>Hiện tại: @c["JudgingStart"] — @c["JudgingEnd"]. Chỉ nhận điểm trong khoảng thời gian này.</p><form class="row" asp-action="Schedule" method="post"><input type="hidden" name="id" value="@id"/><div><label>Bắt đầu</label><input type="datetime-local" name="start" required/></div><div><label>Kết thúc</label><input type="datetime-local" name="end" required/></div><button>Lưu lịch chấm</button></form></details>
}
<h2>Bài dự thi</h2><div class="table-wrap"><table><thead><tr><th>Mã</th><th>Tác phẩm</th><th>Tác giả</th><th>Hạng mục</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(DataRow r in ((DataTable)ViewBag.Submissions).Rows){<tr><td>@r["SubmissionId"]</td><td>@r["Title"]</td><td>@r["Name"]</td><td>@r["CategoryName"]</td><td>@r["Status"]</td><td><a href="/Organizer/Review/@r["SubmissionId"]">Kiểm tra</a></td></tr>}</tbody></table></div>
@if(status=="Open"){<form asp-action="Start" method="post"><input type="hidden" name="id" value="@id"/><button>Bắt đầu chấm thi (sau hạn nhận bài)</button></form>}
@if(status=="Judging"){
<h2>Vòng chấm thi</h2>@foreach(DataRow r in ((DataTable)ViewBag.Rounds).Rows){<div class="panel"><strong>@r["Name"] · @r["State"]</strong><div class="row"><form asp-action="RoundAction" method="post"><input name="id" type="hidden" value="@id"/><input name="round" type="hidden" value="@r["RoundId"]"/><input name="operation" type="hidden" value="close"/><button>Đóng vòng sau khi chấm đủ</button></form><form asp-action="RoundAction" method="post"><input name="id" type="hidden" value="@id"/><input name="round" type="hidden" value="@r["RoundId"]"/><input name="operation" type="hidden" value="next"/><button>Tạo vòng tiếp theo</button></form></div></div>}
<h2>Phân công giám khảo</h2><form class="panel row" asp-action="Assign" method="post"><input type="hidden" name="id" value="@id"/><div><label>Vòng</label><select name="round">@foreach(DataRow r in ((DataTable)ViewBag.Rounds).Rows){<option value="@r["RoundId"]">@r["Name"] · @r["State"]</option>}</select></div><div><label>Bài được duyệt</label><select name="submission">@foreach(DataRow r in ((DataTable)ViewBag.Submissions).Rows){if(r["Status"].ToString()=="Approved"){<option value="@r["SubmissionId"]">#@r["SubmissionId"] @r["Title"]</option>}}</select></div><div><label>Giám khảo</label><select name="judge">@foreach(DataRow r in ((DataTable)ViewBag.Judges).Rows){<option value="@r["UserId"]">@r["Name"] · @r["Email"]</option>}</select></div><button>Phân công</button></form>
<table><thead><tr><th>Vòng</th><th>Bài</th><th>Giám khảo</th><th>Đã xác nhận</th></tr></thead><tbody>@foreach(DataRow r in ((DataTable)ViewBag.Assignments).Rows){<tr><td>@r["RoundName"]</td><td>@r["SubmissionId"]</td><td>@r["JudgeName"]</td><td>@r["Finalized"]</td></tr>}</tbody></table>
<h2>Bảng điểm vòng cuối</h2><table><thead><tr><th>Bài</th><th>Hạng</th><th>Điểm</th></tr></thead><tbody>@foreach(DataRow r in ((DataTable)ViewBag.Rankings).Rows){<tr><td>#@r["SubmissionId"] @r["Title"]</td><td>@r["Position"]</td><td>@r["TotalScore"]</td></tr>}</tbody></table>
<h2>Trao giải</h2><form class="row panel" asp-action="Award" method="post"><input name="id" type="hidden" value="@id"/><div><label>Giải thưởng</label><select name="award">@foreach(DataRow r in ((DataTable)ViewBag.Awards).Rows){<option value="@r["AwardId"]">@r["Name"]</option>}</select></div><div><label>Bài dự thi</label><select name="submission">@foreach(DataRow r in ((DataTable)ViewBag.Rankings).Rows){<option value="@r["SubmissionId"]">#@r["SubmissionId"] @r["Title"]</option>}</select></div><button>Trao giải</button></form>
@foreach(DataRow r in ((DataTable)ViewBag.Winners).Rows){<p>@r["Name"] → #@r["SubmissionId"] @r["Title"]</p>}
<form asp-action="Publish" method="post"><input name="id" type="hidden" value="@id"/><button>Công bố kết quả chính thức</button></form>
}
