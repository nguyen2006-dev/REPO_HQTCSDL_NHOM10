@model DataTable
@{var s=Model.Rows[0];ViewData["Title"]="Kiểm duyệt bài "+s["SubmissionId"];}
<a href="/Organizer/Manage/@s["ContestId"]">← Quản lý cuộc thi</a><h1>@s["Title"]</h1><div class="grid"><div><img class="photo" src="/Assets/Photo/@s["SubmissionId"]" alt="@s["Title"]"/></div><div class="panel"><span class="badge">@s["Status"]</span><p>Tác giả: @s["Name"]</p><p>@s["Stock"] · ISO @s["ISO"] · @s["Format"]</p><p>@s["Camera"] / @s["Lens"]</p><p>Khung @s["FrameNumber"] · @s["Location"]</p><p>Lab: @s["Lab"]<br/>Scan: @s["ScanSpecs"]<br/>Âm bản: @s["NegativeReference"]</p><form asp-action="Review" method="post"><input name="id" value="@s["SubmissionId"]" type="hidden"/><label>Quyết định</label><select name="decision"><option value="Approved">Duyệt</option><option value="Rejected">Từ chối</option></select><label>Lý do</label><textarea name="reason" required maxlength="1000"></textarea><button>Lưu quyết định</button></form></div></div>
<h2>Kiểm tra hỗ trợ</h2><p>Kết quả phát hiện không chứng minh chắc chắn nguồn gốc ảnh. Ban tổ chức quyết định sau khi kiểm tra.</p><div class="grid">@foreach(DataRow r in ((DataTable)ViewBag.Checks).Rows){<article class="card"><span class="badge">@r["Status"]</span><h3>@r["Kind"]</h3><p>@r["Detail"]</p><small>@r["ModelVersion"] · @r["CheckedAt"] UTC</small></article>}</div><form asp-action="Analyze" method="post"><input name="id" type="hidden" value="@s["SubmissionId"]"/><button>Chạy lại phân tích</button></form>
